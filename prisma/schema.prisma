enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}


model Booking {
  booking_id        Int       @id @default(autoincrement())
  customer_id       Int
  turf_id           Int
  date              DateTime
  starts_at         String
  ends_at           String
  booking_status    String    // ENUM (handled in code)
  cancellation_reason String?
  cancellation_time  DateTime?
  payment_status     Boolean  // true = paid

  customer User @relation(fields: [customer_id], references: [user_id])
  turf     Turf @relation(fields: [turf_id], references: [turf_id])
  payment  Payment?
  
  created_at DateTime @default(now())
  @@map("bookings") // Optional: maps to a specific table name in the database
}

model Payment {
  payment_id           Int    @id @default(autoincrement())
  booking_id           Int    @unique
  amount               Int
  commission_amount    Int
  owner_amount         Int
  sender_bkash_number  String
  recipient_bkash_number String
  transaction_id       String
  payment_status       String // ENUM
  created_at           DateTime @default(now())

  booking Booking @relation(fields: [booking_id], references: [booking_id])
  @@map("payments") // Optional: maps to a specific table name in the database
}
