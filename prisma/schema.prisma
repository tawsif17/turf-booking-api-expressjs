generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Division {
  id       Int       @id @default(autoincrement())
  name     String
  bn_name  String
  districts District[]

  @@map("divisions") // Optional: maps to a specific table name in the database
}

model District {
  id          Int       @id @default(autoincrement())
  name        String
  bn_name     String
  division_id Int
  division    Division @relation(fields: [division_id], references: [id], onDelete: Cascade)
  locations   Location[]

  @@map("districts") // Optional: maps to a specific table name in the database
}

model Location {
  id          Int       @id @default(autoincrement())
  district_id Int
  name        String
  bn_name     String
  district    District @relation(fields: [district_id], references: [id], onDelete: Cascade)
  @@map("locations") // Optional: maps to a specific table name in the database
}

model Role {
  role_id Int    @id @default(autoincrement())
  name    String
  users   User[]
  @@map("roles") // Optional: maps to a specific table name in the database
}

model User {
  user_id      Int      @id @default(autoincrement())
  name         String
  phone_number String   @unique
  email        String?  @unique
  password     String
  role_id      Int
  bkash_number String?

  role     Role     @relation(fields: [role_id], references: [role_id])
  turfs    Turf[]   @relation("OwnerTurfs")
  bookings Booking[]
  turfStaff TurfStaff[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users") // Optional: maps to a specific table name in the database
}

model Turf {
  turf_id        Int      @id @default(autoincrement())
  owner_id       Int
  location_name  String   // JSON data in code handles district/division
  name           String
  address_details String
  advance_amount Int

  owner     User         @relation("OwnerTurfs", fields: [owner_id], references: [user_id])
  pricing   TurfPricing[]
  // availability TurfAvailability[]
  bookings  Booking[]
  sports    TurfSports[]
  staff     TurfStaff[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  @@map("turfs") // Optional: maps to a specific table name in the database
}

model TurfStaff {
  id       Int  @id @default(autoincrement())
  turf_id  Int
  user_id  Int

  turf Turf @relation(fields: [turf_id], references: [turf_id])
  user User @relation(fields: [user_id], references: [user_id])
  @@map("turfstaff") // Optional: maps to a specific table name in the database
}

model Sports {
  sport_id Int    @id @default(autoincrement())
  name     String
  turfs    TurfSports[]
  @@map("sports") // Optional: maps to a specific table name in the database
}

model TurfSports {
  id       Int  @id @default(autoincrement())
  turf_id  Int
  sport_id Int

  turf  Turf   @relation(fields: [turf_id], references: [turf_id])
  sport Sports @relation(fields: [sport_id], references: [sport_id])
  @@map("turfsports") // Optional: maps to a specific table name in the database
}

model TurfPricing {
  id              Int    @id @default(autoincrement())
  turf_id         Int
  price_starts_at String
  price_ends_at   String
  price           Int

  turf Turf @relation(fields: [turf_id], references: [turf_id])
  @@map("turfpricing") // Optional: maps to a specific table name in the database
}

